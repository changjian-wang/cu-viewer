{
  "name": "cu-result-viewer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Rendering-only React prototype for inspecting Azure Content Understanding results.",
  "license": "MIT",
  "files": [
    "dist",
    "LICENSE",
    "THIRD-PARTY-NOTICES.txt",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.worker.json --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:consumer": "playwright test --config playwright.consumer.config.ts",
    "verify:consumer": "node tools/verify-packed-consumers.mjs",
    "verify:bundle": "npm run build && npm run build:demo && node tools/verify-rich-result-build.mjs",
    "verify:heif-codec": "pwsh -NoProfile -File ./tools/build-heic-codec.ps1",
    "verify:performance": "npm run verify:bundle && playwright test --config playwright.performance.config.ts",
    "build": "vite build && tsc --project tsconfig.build.json",
    "build:demo": "vite build --config demo/vite.config.ts",
    "preview:demo": "vite preview --config demo/vite.config.ts --host 127.0.0.1 --port 4173 --strictPort",
    "preview:performance": "vite preview --config demo/vite.config.ts --host 127.0.0.1 --port 41873 --strictPort"
  },
  "peerDependencies": {
    "react": ">=18.0.0 <20.0.0",
    "react-dom": ">=18.0.0 <20.0.0",
    "vite": ">=8.0.0 <9.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "highlight.js": "11.11.1",
    "lowlight": "3.3.0",
    "pdfjs-dist": "6.3.289",
    "react-json-view-lite": "2.5.0",
    "react-markdown": "10.1.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "jsdom": "27.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
